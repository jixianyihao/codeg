# Copy to .env and fill in. Never commit real secrets.
# All values below are local-development examples only.

# ── Required ────────────────────────────────────────────────────────────────
DASHBOARD_DATABASE_URL=mysql+pymysql://dashboard:dev-dashboard@mysql:3306/aresclaw_dashboard
# File containing >=32 random bytes (e.g. `head -c48 /dev/urandom > jwt.key`).
DASHBOARD_JWT_KEY_FILE=/run/secrets/dashboard-jwt.key

DASHBOARD_CONTROL_ORIGIN=https://boards.example.internal
DASHBOARD_CONTENT_ORIGIN=https://board-content.example.net

# ── Object storage (private S3 bucket, pre-created) ────────────────────────
DASHBOARD_S3_ENDPOINT_URL=            # empty = AWS regional endpoint
DASHBOARD_S3_REGION=us-east-1
DASHBOARD_S3_BUCKET=aresclaw-dashboards
DASHBOARD_S3_PREFIX=aresclaw/prod/
DASHBOARD_S3_ADDRESSING_STYLE=auto    # auto | path | virtual
# Credentials follow the boto3 standard chain (env/instance role/managed
# file); for static keys use AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
# AWS_SESSION_TOKEN.

# ── Optional ────────────────────────────────────────────────────────────────
DASHBOARD_STORAGE_DIR=/data/staging   # bounded request staging buffer only
DASHBOARD_JWT_ISSUER=aresclaw-dashboard
DASHBOARD_JWT_AUDIENCE=aresclaw-dashboard-api
DASHBOARD_W3_VERIFY_URL=              # intranet W3 normalization endpoint
DASHBOARD_ADMIN_USER_IDS=             # comma list of enterprise UIDs
DASHBOARD_RECOVERY_MODE=0             # 1 = isolated for recovery
